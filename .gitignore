# Only the compact public code release is eligible for GitHub.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/pyproject.toml
!/scripts/
!/.github/

# Local-only numerical and regression tests.
/scripts/tests/
/scripts/probe.c

# Generated files never belong in source control.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.dll
*.so
*.dylib
*.o
*.obj
*.exe
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
