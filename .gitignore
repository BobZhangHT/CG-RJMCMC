# Public source, tests and the four reproduction reports are eligible for GitHub.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/pyproject.toml
!/scripts/
!/.github/

# Public numerical tests and the kernel-weight wrapper are included.

# Only named release reports are public; all other local reports stay private.
!/reports/
/reports/*
!/reports/GITHUB_REPRODUCIBILITY_REPAIR.md
!/reports/REPRODUCTION_MATRIX.md
!/reports/TEST_RESULTS.md
!/reports/PUBLIC_RELEASE_CHECKLIST.md

# Generated files never belong in source control.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.dll
*.so
*.dylib
*.o
*.obj
*.exe
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
